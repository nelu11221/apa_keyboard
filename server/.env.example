# Copiază acest fișier în .env și completează valorile tale.
# Cheile Stripe se obțin gratuit dintr-un cont Stripe (mod test):
# https://dashboard.stripe.com/test/apikeys

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

FRONTEND_URL=http://localhost:5173

# Cale către executabilul compilat al motorului de căutare (engine/).
ENGINE_PATH=../engine/build/search_engine

DATABASE_URL=sqlite:///./searchmart.db
